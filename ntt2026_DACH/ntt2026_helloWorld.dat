        {
          "title": "Select Zephyr's hello_world sample",
          "description": "<span style=\"font-size: 0.9rem;\">In the search box, type </span><code dir=\"ltr\" style=\"color: rgb(14, 138, 125);\">hello world</code><span style=\"font-size: 0.9rem;\">, then select the sample.<br></span><span style=\"font-size: 0.9rem;\">⚠️ </span><strong style=\"font-size: 0.9rem;\">Take care:</strong><span style=\"font-size: 0.9rem;\"> several samples can match this search. Make sure you pick the one with the path </span><strong style=\"font-size: 0.9rem;\"><code dir=\"ltr\" style=\"color: rgb(14, 138, 125);\">zephyr/samples/hello_world</code></strong><span style=\"font-size: 0.9rem;\"> — this is Zephyr's own minimal example, not a vendor-specific variant.&nbsp;</span>",
          "codeBlocks": [],
