var WORKSHOP = {
  "title": "Optional - Sensor Add-on Board",
  "chapters": [
    {
      "title": "Getting Started",
      "description": "",
      "steps": [
        {
          "title": "Hardware Setup",
          "description": "<span style=\"font-size: 14.4px;\">The <code>nRF93M1-DK</code> has two pin headers that allow you to measure current. Jumpers are used here for normal operation. The sensor add-on board already has the jumper positions connected, so we can simply remove the two jumpers and plug the sensor add-on board onto the <code>nRF93M1-DK</code>.</span>",
          "codeBlocks": [],
          "codeBlocksNoCopy": [],
          "images": [
            {
              "src": "data:image/jpeg;base64,",
              "caption": "Hardware Setup"
            }
          ],
          "moreInfo": []
        },
        {
          "title": "Schematic",
          "description": "<div>Here is the schematic of the Sensor Add-on Board</div>",
          "codeBlocks": [],
          "codeBlocksNoCopy": [],
          "images": [
            {
              "src": "data:image/jpeg;base64,",
              "caption": "Sensor Add-on Board Schematic"
            }
          ],
          "moreInfo": []
        }
      ]
    },
    {
      "title": "Software",
      "description": "<div><span style=\"font-size: 14.4px;\">Here, we'll follow the same steps we used in the previous hands-on session:</span></div><div>1. KCONFIG: Enable Sensing Subsystem and appropriate interface</div><div>2. DeviceTree: Enable used Sensors and the used interfaces</div><div>3. Link in C Code</div><div>4. Check if the device is running</div><div>5. Using the Sensor</div>",
      "steps": [
        {
          "title": "1. KCONFG: Enable Sensing Subsystem and appropriate interface",
          "description": "<div><span style=\"font-size: 14.4px;\">The sensors from the previous hands-on session did not require any additional interface drivers. The sensors on the add-on board are connected via I2C. Therefore, we also need to include the I2C driver using <code>CONFIG_I2C=y</code>.&nbsp;</span></div><div><span style=\"font-size: 14.4px;\">We had already used the Sensing Subsystem (<code>CONFIG_SENSOR=y</code>) and floating-point output (<code>CONFIG_CBPRINTF_FP_SUPPORT=y</code></span>) previously, and these configurations are included here solely for the sake of completeness.&nbsp;</div>",
          "codeBlocks": [
            {
              "label": "prj.conf",
              "code": "# Add I2C bus drivers\nCONFIG_I2C=y\n\n# Add Sensing Subsystem drivers\nCONFIG_SENSOR=y\n\n# Enable Floating Point output \nCONFIG_CBPRINTF_FP_SUPPORT=y"
            }
          ],
          "codeBlocksNoCopy": [],
          "images": [],
          "moreInfo": []
        },
        {
          "title": "2. DeviceTree: Enable used Sensors and the used interfaces",
          "description": "<span style=\"font-size: 14.4px;\">In the DeviceTree, we need to configure not only the sensors but also the interface being used. To do this, we use the I2C22 module and define the I2C pins P1.3 (SCL) and P1.2 (SDA). In the DeviceTree, the individual sensors that are addressed via I2C must also be defined in the corresponding I2C node of the DeviceTree. We use the following sensors:</span><div><ul><li><span style=\"font-size: 14.4px;\">Würth Elektronik WSEN-ITDS 3 Axis Acceleration Sensor&nbsp;</span></li><li><span style=\"font-size: 14.4px;\">Würth Elektronik WSEN-TIDS Temperature Sensor&nbsp;</span></li><li><span style=\"font-size: 14.4px;\">Vishay VEML7700 ambient light sensor</span></li></ul></div>",
          "codeBlocks": [
            {
              "label": "app.overlay",
              "code": "&pinctrl {\n    i2c22_default: i2c22_default {\n        group1 {\n            psels = <NRF_PSEL(TWIM_SDA, 1, 2)>,\n                           <NRF_PSEL(TWIM_SCL, 1, 3)>;\n         };\n    };\n\n    i2c22_sleep: i2c22_sleep {\n        group1 {\n            psels = <NRF_PSEL(TWIM_SDA, 1, 2)>,\n                           <NRF_PSEL(TWIM_SCL, 1, 3)>;\n            low-power-enable;\n        };\n    };\n};\n\n&i2c22 {\n    compatible = \"nordic,nrf-twim\";\n    status = \"okay\";\n    clock-frequency = <I2C_BITRATE_STANDARD>;\n    pinctrl-0 = <&i2c22_default>;\n    pinctrl-1 = <&i2c22_sleep>;\n    pinctrl-names = \"default\", \"sleep\";\n\n    /* Würth Elektronik WSEN-ITDS 3 Axis Acceleration Sensor */\n    itds0: itds@18 {\n        compatible = \"we,wsen-itds-2533020201601\";\n        reg = <0x18>;\n        odr = \"12.5\";\n        op-mode = \"low-power/normal\";\n        power-mode = \"normal\";\n    };\n\n    /* Würth Elektronik WSEN-TIDS Temperature Sensor */\n    tids0: tids@3f {\n        compatible = \"we,wsen-tids-2521020222501\";\n        reg = <0x3f>;\n        odr = <25>;\n    };\n\n    /* Vishay VEML7700 ambient light sensor */\n    veml7700: veml7700@10 {\n        compatible = \"vishay,veml7700\";\n        reg = <0x10>;\n    };\n};"
            }
          ],
          "codeBlocksNoCopy": [],
          "images": [],
          "moreInfo": []
        },
        {
          "title": "3. Link in C Code",
          "description": "<span style=\"font-size: 14.4px;\">Here, we read the sensor configurations from the DeviceTree file.</span>",
          "codeBlocks": [
            {
              "label": "main.c",
              "code": "#include <zephyr/kernel.h>\n#include <zephyr/drivers/i2c.h>\n#include <zephyr/drivers/sensor.h>\n\nstatic const struct device *const i2c_bus = DEVICE_DT_GET(DT_NODELABEL(i2c22));\nstatic const struct device *const itds = DEVICE_DT_GET(DT_NODELABEL(itds0));\nstatic const struct device *const tids = DEVICE_DT_GET(DT_NODELABEL(tids0));\nstatic const struct device *const veml7700 = DEVICE_DT_GET(DT_NODELABEL(veml7700));"
            }
          ],
          "codeBlocksNoCopy": [],
          "images": [],
          "moreInfo": []
        },
        {
          "title": "4. Check if the device is running",
          "description": "<div><span style=\"font-size: 14.4px;\">The first code snippet checks the sensors using the DeviceTree implementation.</span></div><div><span style=\"font-size: 14.4px;\"><br></span></div><div><span style=\"font-size: 14.4px;\">Of course, it's also possible to test the sensors within your own application. The second and third code snippets implement such a test.</span></div>",
          "codeBlocks": [
            {
              "label": "main.c => int main(void) function",
              "code": "    if (!device_is_ready(i2c_bus)) {\n        printk(\"Error: I2C bus device is not ready\\n\");\n        return 0;\n    }\n\n    if (!device_is_ready(itds)) {\n        printk(\"Error: WSEN-ITDS device is not ready\\n\");\n        return 0;\n    }\n\n    if (!device_is_ready(tids)) {\n        printk(\"Error: WSEN-TIDS device is not ready\\n\");\n        return 0;\n    }\n\n    if (!device_is_ready(veml7700)) {\n        printk(\"Error: VEML7700 device is not ready\\n\");\n        return 0;\n    }"
            },
            {
              "label": "main.c => user defined sensor test",
              "code": "/*\n * Raw I2C address probe, independent of the WSEN-ITDS driver. This only\n * checks whether *something* ACKs the given 7-bit address on the bus - it\n * does not talk to any particular register - so it isolates wiring/soldering\n * problems (no ACK at all) from configuration problems (ACK, but the driver\n * still rejects the device, e.g. because of a WHO_AM_I mismatch).\n */\nstatic void i2c_probe_addr(uint8_t addr, const char *name)\n{\n    uint8_t dummy;\n    int ret = i2c_read(i2c_bus, &dummy, 1, addr);\n\n    printk(\"I2C probe: 0x%02x (%s): %s (err %d)\\n\", addr, name,\n    ret == 0 ? \"ACK - device responded\" : \"NACK/no response\", ret);\n}"
            },
            {
              "label": "main.c => int main(void) function => user defined sensor test",
              "code": "    /*\n     * SAO=GND should put the ITDS at 0x18. Also probe 0x19 (SAO=VDD) in\n     * case the SAO pin isn't actually reaching GND (e.g. a cold solder\n     * joint or open connection can leave it floating/high).\n     */\n    i2c_probe_addr(0x18, \"ITDS, SAO=GND\");\n    //i2c_probe_addr(0x19, \"ITDS, SAO=VDD\");\n    i2c_probe_addr(0x3f, \"TIDS, SAO=GND\");\n    i2c_probe_addr(0x10, \"VEML7700\");"
            }
          ],
          "codeBlocksNoCopy": [],
          "images": [],
          "moreInfo": []
        },
        {
          "title": "5. Using the Sensor",
          "description": "",
          "codeBlocks": [
            {
              "label": "main.c => int main(void) function",
              "code": "    while (1) {\n        struct sensor_value accel[3];\n        struct sensor_value itds_temp;\n        struct sensor_value tids_temp;\n        int ret;\n\n        ret = sensor_sample_fetch(itds);\n        if (ret < 0) {\n            printk(\"ITDS: failed to fetch sample (%d)\\n\", ret);\n        } else {\n            sensor_channel_get(itds, SENSOR_CHAN_ACCEL_XYZ, accel);\n            sensor_channel_get(itds, SENSOR_CHAN_AMBIENT_TEMP, &itds_temp);\n\n            printk(\"ITDS: accel x=%.3f y=%.3f z=%.3f [m/s^2], temp=%.2f C\\n\",\n                   sensor_value_to_double(&accel[0]),\n                   sensor_value_to_double(&accel[1]),\n                   sensor_value_to_double(&accel[2]),\n                   sensor_value_to_double(&itds_temp));\n        }\n\n        ret = sensor_sample_fetch(tids);\n        if (ret < 0) {\n            printk(\"TIDS: failed to fetch sample (%d)\\n\", ret);\n        } else {\n            sensor_channel_get(tids, SENSOR_CHAN_AMBIENT_TEMP, &tids_temp);\n            printk(\"TIDS: temp=%d.%06d C\\n\", tids_temp.val1, tids_temp.val2);\n        }\n\n        ret = sensor_sample_fetch(veml7700);\n        if (ret < 0) {\n            printk(\"VEML7700: failed to fetch sample (%d)\\n\", ret);\n        } else {\n            struct sensor_value light;\n\n            sensor_channel_get(veml7700, SENSOR_CHAN_LIGHT, &light);\n            printk(\"VEML7700: light=%d.%06d lux\\n\", light.val1, light.val2);\n        }\n\n        k_sleep(K_SECONDS(1));\n    }"
            }
          ],
          "codeBlocksNoCopy": [],
          "images": [],
          "moreInfo": []
        }
      ]
    },
